@model ServiceDetailsViewModel
@{
    var s = Model.Service;
    ViewData["Title"] = s.Name;
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
    var backUrl = Url.Action("Details", "Services", new { id = s.Id });
}

<div class="card mb-4"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-start">
        <div>
            <span class="badge pbadge @UiHelper.ProviderClass(s.Provider.Name)">@s.Provider.Name</span>
            <span class="badge text-bg-secondary rounded-pill">@s.Category</span>
            <h3 class="mt-2">@s.Name</h3>
            <p class="text-muted">@s.Description</p>
        </div>
        <form asp-controller="Compare" asp-action="Add" method="post" class="ajax-compare">
            <input type="hidden" name="id" value="@s.Id" />
            <input type="hidden" name="returnUrl" value="@backUrl" />
            <button type="submit" class="btn btn-primary">+ Add to Compare</button>
        </form>
    </div>
    <div class="row text-center g-3 mt-1">
        <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted small">Starting Price</div>
            <div class="price">@(s.StartingPrice == 0 ? "Pay per use" : "$" + s.StartingPrice.ToString("0.00"))</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted small">Uptime SLA</div>
            <div class="price">@s.UptimeSla.ToString("0.###")%</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted small">Regions</div>
            <div class="price">@s.RegionCount</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted small">Free Tier</div>
            <div class="price">@(s.FreeTier ? "Yes" : "No")</div></div></div>
    </div>
</div></div>

<div class="row g-4">
    <div class="col-lg-7">
        <h5>
            Reviews
            @if (s.Reviews.Any()) { <span class="stars">★</span> <span>@s.AvgRating.ToString("0.0")</span> <small class="text-muted">(@s.Reviews.Count)</small> }
        </h5>
        @foreach (var r in s.Reviews.OrderByDescending(x => x.CreatedOn))
        {
            <div class="card mb-2"><div class="card-body py-2">
                <div class="d-flex justify-content-between">
                    <strong>@r.ReviewerName</strong>
                    <span class="stars">@(new string('★', r.Rating))<span class="text-muted">@(new string('★', 5 - r.Rating))</span></span>
                </div>
                <div>@r.Comment</div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">@r.CreatedOn.ToString("dd MMM yyyy")</small>
                    @if (isAdmin)
                    {
                        <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.Id" method="post"
                              onsubmit="return confirm('Delete this review?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </div>
            </div></div>
        }
        @if (!s.Reviews.Any())
        {
            <p class="text-muted">No reviews yet. Be the first to review!</p>
        }
    </div>
    <div class="col-lg-5">
        <h5>Write a Review</h5>
        <div class="card shadow-sm"><div class="card-body">
            <form asp-controller="Reviews" asp-action="Create" method="post">
                <partial name="_ReviewForm" model="Model.NewReview" />
                <button type="submit" class="btn btn-primary mt-3">Submit Review</button>
            </form>
        </div></div>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-4">Back to Services</a>
