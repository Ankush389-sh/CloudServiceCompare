@{
    var theme = Context.Request.Cookies["theme"] == "dark" ? "dark" : "light";
    var palette = Context.Request.Cookies["palette"] ?? "indigo";
    if (!new[] { "indigo", "ocean", "emerald", "sunset" }.Contains(palette)) { palette = "indigo"; }
    var admin = Context.Session.GetString("Admin");
    var cmp = Context.Session.GetString("CompareIds");
    var cmpCount = string.IsNullOrEmpty(cmp) ? 0 : cmp.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@theme" data-palette="@palette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CloudCompare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div id="topbar"></div>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">☁️ CloudCompare</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Providers" asp-action="Index">Providers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">Services</a></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Compare" asp-action="Index">
                            Compare <span id="cmpBadge" class="badge rounded-pill bg-light text-dark">@cmpCount</span>
                        </a>
                    </li>
                </ul>
                <div class="dots" title="Choose colour theme">
                    <button type="button" class="dot" data-palette="indigo" title="Indigo"></button>
                    <button type="button" class="dot" data-palette="ocean" title="Ocean"></button>
                    <button type="button" class="dot" data-palette="emerald" title="Emerald"></button>
                    <button type="button" class="dot" data-palette="sunset" title="Sunset"></button>
                </div>
                <a id="themeToggle" class="btn btn-sm btn-light me-2" asp-controller="Home" asp-action="ToggleTheme" asp-route-returnUrl="@returnUrl">
                    @(theme == "light" ? "🌙 Dark" : "☀️ Light")
                </a>
                @if (!string.IsNullOrEmpty(admin))
                {
                    <span class="navbar-text me-2">Admin: @admin</span>
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Admin Login</a>
                }
            </div>
        </div>
    </nav>

    <div id="flash">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-3 border-top small">
        CloudCompare · ASP.NET Core MVC · Entity Framework Core · MySQL · Prices shown are sample data
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
