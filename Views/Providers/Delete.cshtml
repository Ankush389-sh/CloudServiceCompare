@model Provider
@{ ViewData["Title"] = "Delete Provider"; }

<h3 class="mb-3 text-danger">Delete Provider</h3>
<div class="card shadow-sm"><div class="card-body">
    <p>Are you sure you want to delete this provider?</p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Headquarters</dt><dd class="col-sm-9">@Model.Headquarters</dd>
        <dt class="col-sm-3">Website</dt><dd class="col-sm-9">@Model.Website</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div></div>
